{
  "name": "sql_terminal_agent",
  "version": "1.0.0",
  "scripts": {
    "seed": "node src/seed.js",
    "ingest": "node src/ingest.js",
    "env:setup": "cp .env.example .env",
    "start": "node --env-file=.env.local src/index.js",
    "dev": "node --watch --env-file=.env.local src/index.js",
    "test": "node --test --experimental-test-module-mocks ./src/*.spec.js",
    "test:watch": "node --experimental-test-module-mocks --watch --test ./src/*.spec.js"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@ai-sdk/openai": "1.3.0",
    "@faker-js/faker": "9.0.0",
    "ai": "4.3.0",
    "zod": "^3.25.76"
  }
}
